<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
  Single-arm URDF — "Astral Arm" extracted from RobotMain_URDF (left arm).

  Kinematic chain:
    body_link → shoulder_mount → base_link → joint1 → link1 → joint2 → link2
                         (fixed)   (empty)                           ↓
              link7 ← joint7 ← link6 ← joint6 ← link5 ← joint5 ← link4 ← joint4
                                                                       ↑
                                                             link3 ← joint3

  body_link  : torso geometry + mass (shared when assembled as dual-arm)
  base_link  : empty coordinate frame at shoulder joint center
  joint1~7   : 7-DOF arm: shoulder(3) + elbow(1) + wrist(3)

  For dual-arm assembly, body_link appears once; left_/right_ prefixes are
  added to base_link and all arm links/joints, mounted via shoulder_mount.

  Mesh source: SolidWorks → RobotMain_URDF, re-meshed for standalone package.
  ============================================================================ -->
<robot name="astral_arm">

  <!-- ======================================================================= -->
  <!--  BODY LINK — robot torso                                               -->
  <!--  Has full mesh for standalone viewing of the single arm.               -->
  <!--  In the dual-arm combined URDF, body_link is defined separately so     -->
  <!--  the torso renders only once.                                          -->
  <!-- ======================================================================= -->
  <link name="body_link">
    <inertial>
      <origin xyz="-0.000397796461260431 -0.00152495035220991 0.311174521880867" rpy="0 0 0"/>
      <mass value="3.83585130314113"/>
      <inertia ixx="0.0177204149690876" ixy="-9.93687937361393E-07" ixz="-5.47542776773803E-05" iyy="0.0184032317304656" iyz="-0.000201716977992903" izz="0.00624143314456702"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================================================================= -->
  <!--  SHOULDER MOUNT — fixed offset from torso center to shoulder joint      -->
  <!--  In the combined dual-arm file, left/right mounts use opposite Y.       -->
  <!-- ======================================================================= -->
  <joint name="shoulder_mount" type="fixed">
    <origin xyz="0.09495 0 0.412" rpy="0 0 0"/>
    <parent link="body_link"/>
    <child link="base_link"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  BASE LINK — empty frame at shoulder joint center                       -->
  <!--  This is the root of the arm kinematic chain. In dual-arm assembly,     -->
  <!--  two copies (left_base_link / right_base_link) mount to one body_link. -->
  <!-- ======================================================================= -->
  <link name="base_link"/>

  <!-- ======================================================================= -->
  <!--  JOINT 1 — shoulder rotation  (was Joint_la_1)                         -->
  <!--  Base is already at shoulder joint, so origin is identity.              -->
  <!-- ======================================================================= -->
  <link name="link1">
    <inertial>
      <origin xyz="0.00413700977741738 3.13242155845495E-05 -0.102952710945695" rpy="0 0 0"/>
      <mass value="0.425143933299929"/>
      <inertia ixx="0.000400795538974745" ixy="-8.79834183404054E-07" ixz="5.55331453556677E-05" iyy="0.000446033724929825" iyz="5.25094998188193E-07" izz="0.00037515957060443"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link1.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link1.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5708 0 1.5708"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="100" velocity="10"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  JOINT 2 — shoulder pitch  (was Joint_la_2)                            -->
  <!-- ======================================================================= -->
  <link name="link2">
    <inertial>
      <origin xyz="1.16366136365675E-07 -0.0515369360052761 -0.0233393507591638" rpy="0 0 0"/>
      <mass value="0.170397147939771"/>
      <inertia ixx="0.000176632928221221" ixy="9.88510099541285E-11" ixz="-7.16368604056304E-11" iyy="0.000124223561257769" iyz="5.05360861009142E-05" izz="0.000154841820923681"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link2.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link2.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0.00245 0 -0.11655" rpy="3.1416 1.5708 0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.3" upper="2.0" effort="100" velocity="10"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  JOINT 3 — upper arm rotation  (was Joint_la_3)                        -->
  <!-- ======================================================================= -->
  <link name="link3">
    <inertial>
      <origin xyz="0.0052733306336345 0.000541043280667566 -0.0560142283878082" rpy="0 0 0"/>
      <mass value="0.828197516273737"/>
      <inertia ixx="0.00146512401102827" ixy="-4.70601849889154E-06" ixz="0.000171052404649863" iyy="0.00148986909371496" iyz="1.9876103888156E-05" izz="0.000641319058946128"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link3.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link3.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin xyz="0 -0.11605 0.00245" rpy="-1.5708 0 0"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.2689" upper="2.2689" effort="100" velocity="10"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  JOINT 4 — elbow  (was Joint_la_4)                                      -->
  <!-- ======================================================================= -->
  <link name="link4">
    <inertial>
      <origin xyz="2.25766184129186E-07 -0.0305678127128807 0.0269754610593833" rpy="0 0 0"/>
      <mass value="0.0732871793694264"/>
      <inertia ixx="6.11533842326613E-05" ixy="1.21221675532134E-10" ixz="2.75704116734621E-09" iyy="3.9792576295254E-05" iyz="-1.67758586650268E-05" izz="5.33009737500945E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link4.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link4.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin xyz="-5E-05 0 -0.12995" rpy="1.5708 0 1.5708"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.26" upper="0.0" effort="100" velocity="10"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  JOINT 5 — forearm rotation  (was Joint_la_5)                          -->
  <!-- ======================================================================= -->
  <link name="link5">
    <inertial>
      <origin xyz="0.000917722983989122 -0.00172455542728443 0.0413047183843976" rpy="0 0 0"/>
      <mass value="0.357479627979921"/>
      <inertia ixx="0.00023855008866071" ixy="3.26564382789649E-07" ixz="-2.26698562006965E-07" iyy="0.000245543547575495" iyz="2.00410252204386E-06" izz="0.00014874826512795"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link5.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link5.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin xyz="0 -0.0819 5E-05" rpy="1.5708 -1.5708 0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7802" upper="1.7802" effort="100" velocity="10"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  JOINT 6 — wrist pitch  (was Joint_la_6)                               -->
  <!-- ======================================================================= -->
  <link name="link6">
    <inertial>
      <origin xyz="-0.00209616210931616 -7.60432338380648E-05 -0.0345869016249898" rpy="0 0 0"/>
      <mass value="0.223326104264372"/>
      <inertia ixx="0.0001191916758025" ixy="5.11035010670013E-07" ixz="5.44350071946939E-09" iyy="0.000125075221210904" iyz="-1.50912446701465E-09" izz="0.000116882152036891"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link6.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.866666666666667 0.866666666666667 0.890196078431372 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link6.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin xyz="-0.0346 0 0.1446" rpy="1.5708 0 -1.5708"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.8" upper="0.85" effort="100" velocity="10"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  JOINT 7 — wrist rotation / end-effector mount  (was Joint_la_7)       -->
  <!-- ======================================================================= -->
  <link name="link7">
    <inertial>
      <origin xyz="-3.07727787696166E-10 -0.0259940225273303 0.0199872280031537" rpy="0 0 0"/>
      <mass value="0.015413107363488"/>
      <inertia ixx="8.04290603753782E-06" ixy="-2.14770052671349E-14" ixz="-1.47932442430447E-13" iyy="5.65123319283211E-06" iyz="-2.06676272068973E-06" izz="6.48331175250713E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link7.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://astral_arm_description/meshes/link7.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint7" type="revolute">
    <origin xyz="-0.0036 0 -0.03455" rpy="3.1416 1.5708 0"/>
    <parent link="link6"/>
    <child link="link7"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="10"/>
  </joint>

</robot>
