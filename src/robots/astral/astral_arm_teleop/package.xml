<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astral_arm_teleop</name>
  <version>0.1.0</version>
  <description>
    Astral dual-arm teleop: pose processing + DH/URDF IK in torso base_link,
    publishes /left_arm|/right_arm/joint_commands for astral_robot_control.
    Arm-only — gripper and dexterous hand are composed by morla_bringup.
  </description>
  <maintainer email="loopkok@todo.todo">loopkok</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>ament_index_python</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>morla_input</exec_depend>
  <exec_depend>astral_robot_control</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>morla_core</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>morla_core</exec_depend>
</package>
