<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wujihand_driver</name>
  <version>1.0.1</version>
  <description>ROS2 driver node for WujiHand dexterous hand</description>
  <maintainer email="wuji@example.com">wuji</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>wujihand_msgs</depend>

  <!-- wujihandcpp is a vendor C++ SDK without a rosdep key. Provide it via
       WUJIHANDCPP_PREFIX, ~/.local/opt/wujihandcpp, or the in-tree source
       layout; see scripts/setup_wujihandcpp_user.sh and CMakeLists.txt. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
  <depend>morla_interfaces</depend>
</package>
