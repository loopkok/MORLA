<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xnero_mujoco_sim</name>
  <version>0.1.0</version>
  <description>XNero MuJoCo stand-in using MORLA standard arm and native internal XHand interfaces.</description>
  <maintainer email="loopkok@todo.todo">loopkok</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>xhand_control_interfaces</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>morla_core</exec_depend>
  <!-- pip: mujoco (见 README；与 rclpy 同在 /usr/bin/python3) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
