<?xml version="1.0"?>
<package format="3">
  <name>morla_epg_driver</name><version>0.1.0</version>
  <description>Independent Jodell EPG50-060 RS485 gripper component and ROS2 driver.</description>
  <maintainer email="maintainers@morla.dev">MORLA maintainers</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>morla_core</exec_depend><exec_depend>morla_runtime</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <!-- modbus-tk has no rosdep key; setup.py install_requires pulls it from PyPI
       together with the vendor SDK wheel. -->

  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
