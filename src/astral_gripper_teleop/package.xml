<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astral_gripper_teleop</name>
  <version>0.1.0</version>
  <description>
    Left (or right) gripper teleop adapter: Quest3 pinch → /{side}_gripper/command.
    Does not talk to hardware; astral_robot_control consumes the command.
    Swap the adapter later (hardware trigger) without changing the driver contract.
  </description>
  <maintainer email="loopkok@todo.todo">loopkok</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>astral_data_collect</exec_depend>
</package>
