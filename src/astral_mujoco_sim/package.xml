<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astral_mujoco_sim</name>
  <version>0.1.0</version>
  <description>
    MuJoCo stand-in for Astral dual-arm driver.
    Subscribes /left_arm|/right_arm/joint_commands and drives dual-arm MJCF.
  </description>
  <maintainer email="loopkok@todo.todo">loopkok</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>ament_index_python</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>astral_arm_teleop</exec_depend>
  <exec_depend>quest3_hand_mocap</exec_depend>
  <exec_depend>astral_gripper_teleop</exec_depend>
  <exec_depend>astral_teleop</exec_depend>
  <exec_depend>astral_robot_description</exec_depend>
  <!-- pip: mujoco -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
