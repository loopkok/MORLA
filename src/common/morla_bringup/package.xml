<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>morla_bringup</name>
  <version>0.1.0</version>
  <description>
    Whole-robot teleop bringup. No motion code — includes existing packages:
    Quest3 mocap, dual-arm teleop, left gripper pinch, right Wuji hand.
  </description>
  <maintainer email="loopkok@todo.todo">loopkok</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>morla_input</exec_depend>
  <exec_depend>quest3_video_streamer</exec_depend>
  <exec_depend>astral_arm_teleop</exec_depend>
  <exec_depend>astral_gripper_teleop</exec_depend>
  <exec_depend>astral_robot_control</exec_depend>
  <exec_depend>wuji_glove</exec_depend>
  <exec_depend>wujihand_retargeting</exec_depend>
  <exec_depend>wujihand_control</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>morla_data_collect</exec_depend>
</package>
