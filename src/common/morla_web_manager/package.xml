<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>morla_web_manager</name>
  <version>0.1.0</version>
  <description>
    MORLA web manager for robot operation and monitoring.
    Subscribes to existing joint topics (read-only), publishes only to the
    existing /teleop/armed and /teleop/disarm control topics for pause/resume,
    and orchestrates ros2 launch via subprocess for start/stop. Serves a
    React SPA over FastAPI + WebSocket on port 8080.
  </description>
  <maintainer email="loopkok@todo.todo">loopkok</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>morla_core</exec_depend>
  <exec_depend>morla_bringup</exec_depend>
  <exec_depend>morla_operator_control</exec_depend>
  <exec_depend>morla_input</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>nero_arm_teleop</exec_depend>
  <exec_depend>nero_robot_control</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
