{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morla.local/schemas/assembly.schema.json",
  "type": "object",
  "properties": {
    "assembly_version": {
      "const": 1
    },
    "assembly_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "instances": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "plugin": {
            "type": "string",
            "minLength": 1
          },
          "plugin_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "plugin_version": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "backend": {
            "enum": [
              "fake",
              "sim",
              "real",
              "ros2_control"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "config": {
            "type": "object"
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "child": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": "string",
            "minLength": 1
          },
          "calibration": {
            "type": "string",
            "minLength": 1
          },
          "transform": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "child",
          "parent"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "controller": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object"
          },
          "deadman": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "max_age_ms": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "controller",
          "deadman"
        ],
        "additionalProperties": false
      }
    },
    "control_groups": {
      "type": [
        "object",
        "array"
      ]
    },
    "capture": {
      "type": "object",
      "properties": {
        "state": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensors": {
          "type": "array"
        },
        "dataset_fps": {
          "type": "integer",
          "minimum": 1
        },
        "action_source": {
          "enum": [
            "command",
            "next_state",
            "requested",
            "authorized",
            "dispatched",
            "feedback",
            "dispatched_command",
            "authorized_command",
            "requested_command"
          ]
        },
        "hold_frames": {
          "type": "integer",
          "minimum": 0
        },
        "max_gap_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label_source": {
          "type": "string",
          "minLength": 1
        },
        "reference_clock": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        },
        "auxiliary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    },
    "legacy": {
      "type": "object"
    }
  },
  "required": [
    "assembly_version",
    "assembly_id",
    "revision",
    "instances"
  ],
  "additionalProperties": false
}
