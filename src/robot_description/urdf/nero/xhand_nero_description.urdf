    <origin xyz="0.032 0 -0.0235" rpy="-1.5708 0 -1.5708"/>
    <parent link="left_link7"/>
    <child link="left_gripper_flange"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  LEFT CONNECTOR                                                         -->
  <!--  STL origin at corner; visual offset centres BB on link origin.         -->
  <!-- ======================================================================= -->
  <link name="left_connector">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/nero/connector/left_connector.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/nero/connector/left_connector.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_connector_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="left_gripper_flange"/>
    <child link="left_connector"/>
  </joint>

  <!-- ======================================================================= -->
  <!--  LEFT HAND MOUNT  (hand at same origin as connector link)               -->
  <!-- ======================================================================= -->
  <joint name="left_hand_mount" type="fixed">
    <parent link="left_connector"/>
    <child link="left_hand_link"/>
    <origin xyz="0 0 0.028" rpy="0 0 3.14159"/>
  </joint>

