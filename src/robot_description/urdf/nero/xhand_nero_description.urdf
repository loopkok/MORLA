    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/nero/nero/link2.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- Hardware-coordinate J2 origin. The historical sim-only +90deg offset is
       preserved at urdf/nero/legacy/xhand_nero_description_j2_offset.urdf. -->
  <joint name="left_joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5707963 3.1415926 0"/>
    <parent link="left_link1"/>
    <child link="left_link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.74533" upper="1.74533" effort="100" velocity="5"/>
  </joint>

  <link name="left_link3">
