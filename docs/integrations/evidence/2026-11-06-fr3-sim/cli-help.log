                           [--input-device INPUT_DEVICE]
                           [--input-backend {fake,real}]
                           [--sim-mode {physics,kinematic}]
                           [--sim-display {web,local,both}] [--port PORT]
                           [--log-dir LOG_DIR] [--store STORE]

